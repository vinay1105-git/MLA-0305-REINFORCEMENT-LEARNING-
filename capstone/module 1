server <- function(input, output, session) {
  
  dataset_rv <- reactiveVal(NULL)
  rl_result_rv <- reactiveVal(NULL)
  comp_df_rv <- reactiveVal(NULL)
  
  # Scenario Presets logic
  observeEvent(input$preset_scenario, {
    if (input$preset_scenario == "Outbreak Emergency") {
      updateNumericInput(session, "num_agents", value = 1500)
      updateNumericInput(session, "num_clusters", value = 4)
      updateSliderInput(session, "rl_episodes", value = 80)
    } else if (input$preset_scenario == "Resource Scarcity") {
      updateNumericInput(session, "num_agents", value = 800)
      updateNumericInput(session, "num_clusters", value = 3)
      updateSliderInput(session, "rl_episodes", value = 60)
    } else if (input$preset_scenario == "High-Threat Invasion") {
      updateNumericInput(session, "num_agents", value = 2000)
      updateNumericInput(session, "num_clusters", value = 5)
      updateSliderInput(session, "rl_episodes", value = 100)
    }
  })
  
  # Auto-initialize dataset on app start
  observe({
    if (is.null(dataset_rv())) {
      df <- generate_dataset(n = 1000, g = 3, seed = 123)
      dataset_rv(df)
      
      updateSelectInput(session, "filter_agent_type", 
                        choices = c("All", unique(df$Agent_Type)))
      
      rl_res <- run_rl_simulation(df, episodes = 50, alpha = 0.1, gamma = 0.9, epsilon = 0.2)
      rl_result_rv(rl_res)
      
      comp_df <- evaluate_hybrid_models(df, rl_res$history)
      comp_df_rv(comp_df)
    }
  })
  
  # Regenerate Dataset
  observeEvent(input$generate_btn, {
    df <- generate_dataset(n = input$num_agents, g = input$num_clusters, seed = input$seed_val)
    dataset_rv(df)
    
    updateSelectInput(session, "filter_agent_type", 
                      choices = c("All", unique(df$Agent_Type)))
    
    if (!dir.exists("data")) dir.create("data")
    write.csv(df, "data/phoenix_dataset.csv", row.names = FALSE)
  })
  
  # Run Hybrid Simulation with UI Hyperparameters
  # Run Hybrid Simulation with UI Hyperparameters
  observeEvent(input$run_sim_btn, {
    req(dataset_rv())
    df <- dataset_rv()
    
    rl_res <- run_rl_simulation(
      df, 
      episodes = input$rl_episodes, 
      alpha = input$rl_alpha,
      gamma = input$rl_gamma,
      epsilon = input$rl_epsilon
    )
    
    # Update state with simulated spatial positions & RL history
    rl_result_rv(rl_res)
    if (!is.null(rl_res$updated_df)) {
      dataset_rv(rl_res$updated_df)
    }
    
    comp_df <- evaluate_hybrid_models(df, rl_res$history)
    comp_df_rv(comp_df)
    
    generate_all_graphs(rl_res$updated_df, rl_res$history, comp_df)
  })
  # Filtered Data Reactive Pipeline
  filtered_df <- reactive({
    req(dataset_rv())
    df <- dataset_rv()
    
    if (input$filter_agent_type != "All") {
      df <- df[df$Agent_Type == input$filter_agent_type, ]
    }
    
    df <- df[df$Health >= input$filter_health, ]
    return(df)
  })
  
  output$dataset_table <- renderDT({
    req(filtered_df())
    datatable(filtered_df(), options = list(pageLength = 10, scrollX = TRUE))
  })
  
  output$agent_summary_table <- renderTable({
    req(filtered_df())
    calculate_agent_stats(filtered_df())
  }, striped = TRUE, hover = TRUE)
  
  output$centroid_table <- renderTable({
    req(filtered_df())
    calculate_centroid(filtered_df())
  }, striped = TRUE, hover = TRUE)
  
  output$q_table_output <- renderTable({
    req(rl_result_rv())
    as.data.frame(rl_result_rv()$q_table)
  }, rownames = TRUE, striped = TRUE, hover = TRUE)
  
  output$strategy_output <- renderText({
    req(rl_result_rv())
    generate_survival_strategy(rl_result_rv()$q_table)
  })
  
  output$model_comp_table <- renderTable({
    req(comp_df_rv())
    comp_df_rv()
  }, striped = TRUE, hover = TRUE)
  
  # Plot Renderers
  output$plot_cluster <- renderPlot({
    req(filtered_df())
    plot_cluster_distribution(filtered_df())
  })
  
  output$plot_spatial <- renderPlot({
    req(filtered_df())
    plot_agent_locations(filtered_df())
  })
  
  output$plot_density <- renderPlot({
    req(filtered_df())
    plot_spatial_density(filtered_df())
  })
  
  output$plot_survival <- renderPlot({
    req(filtered_df())
    plot_survival_vs_infection(filtered_df())
  })
  
  output$plot_rl_reward <- renderPlot({
    req(rl_result_rv())
    plot_rl_learning_curve(rl_result_rv()$history)
  })
  
  output$plot_rl_survival <- renderPlot({
    req(rl_result_rv())
    plot_rl_survival_trend(rl_result_rv()$history)
  })
  
  output$plot_model_comparison <- renderPlot({
    req(comp_df_rv())
    plot_model_comparison(comp_df_rv())
  })
  
  # Export Handlers
  output$download_csv <- downloadHandler(
    filename = function() {
      paste0("phoenix_dataset_", Sys.Date(), ".csv")
    },
    content = function(file) {
      write.csv(filtered_df(), file, row.names = FALSE)
    }
  )
  
  output$download_metrics <- downloadHandler(
    filename = function() {
      paste0("phoenix_model_evaluation_", Sys.Date(), ".csv")
    },
    content = function(file) {
      req(comp_df_rv())
      write.csv(comp_df_rv(), file, row.names = FALSE)
    }
  )
  
  output$download_strategy <- downloadHandler(
    filename = function() {
      paste0("phoenix_survival_strategy_", Sys.Date(), ".txt")
    },
    content = function(file) {
      req(rl_result_rv())
      writeLines(generate_survival_strategy(rl_result_rv()$q_table), file)
    }
  )
}

shinyApp(ui = ui, server = server)
